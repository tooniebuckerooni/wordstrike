{
  // Deployed from GitHub by .github/workflows/deploy-worker.yml on every push
  // to main that touches worker/**.
  //
  // "account_id" and the KV namespace "id" are real, live values (neither is
  // secret). Don't change the KV id: a wrong one makes `wrangler deploy` bind
  // a brand-new EMPTY namespace, silently orphaning every registered name and
  // streak in production. "name" must stay "wordjab-api" — a different name
  // creates a second Worker instead of updating the live one.
  "name": "wordjab-api",
  "main": "wordjab-api.js",
  "compatibility_date": "2024-01-01",
  "account_id": "1507efb50324cd0f223d30adf094565f",
  "kv_namespaces": [
    { "binding": "LEADERBOARD", "id": "859f305dd20940c6b4730047e036dd54" }
  ],
  // Rebuilds the leaderboard's streak + weekly sections from every player's
  // own record (rebuildBoard in wordjab-api.js), so an entry dropped by a
  // concurrent KV write heals within minutes instead of staying lost.
  "triggers": { "crons": ["*/10 * * * *"] }
}
